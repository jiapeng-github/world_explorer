# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local narration work files
/tool/audio/.production/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Reproducible narration previews and duplicate delivery archives
/tool/audio/generated/
/tool/audio/friendly-guide-narrations.zip
/docs/redesign/world-atlas-redesign-v1.zip
/docs/review/*.zip

# Bulk QA traversal artifacts; keep screenshots cited by the review
/docs/review/dumps/
/docs/review/recheck/
/docs/review/*_stdout.txt
/docs/review/*_log.jsonl
